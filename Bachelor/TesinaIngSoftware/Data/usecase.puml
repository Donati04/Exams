@startuml
left to right direction
skinparam packageStyle rectangle
title Use Case Diagram - Reverse Proxy HTTP

actor "Client / Browser" as Client
actor "Amministratore" as Admin
actor "Servizio Backend" as Backend <<External System>>

rectangle "Reverse Proxy" {
  usecase "Invio Richiesta HTTP" as UC1
  usecase "Instradamento della Richiesta" as UC2
  usecase "Risoluzione Asset\ntramite Referer" as UC3
  usecase "Bilanciamento del Carico\ntra Istanze" as UC4
  usecase "Inoltro della Richiesta\nal Backend" as UC5
  usecase "Configurazione delle Rotte" as UC6
}

Client --> UC1
UC1 ..> UC2 : <<include>>
UC3 ..> UC2 : <<extend>>
UC2 ..> UC4 : <<include>>
UC4 ..> UC5 : <<include>>
UC5 --> Backend
Admin --> UC6

note bottom of UC3
  Attivato quando il path richiesto non
  corrisponde a nessuna rotta esplicita
  (tipico delle risorse statiche referenziate
  da una pagina gia' instradata).
end note

@enduml
